
/* ═══════════════════════════════════════════════════════════════════════════
   Rofi — config.rasi  (drun only)
   ═══════════════════════════════════════════════════════════════════════════ */

configuration {
  modes:               "drun";
  show-icons:          true;
  icon-theme:          "Papirus";
  drun-display-format: "{name}";
  display-drun:        " Apps";
  case-sensitive:      false;
  cycle:               true;
  sidebar-mode:        false;
  hover-select:        true;
  me-select-entry:     "";
  me-accept-entry:     "MousePrimary";
  terminal:            "alacritty";
}


@theme "~/.config/rofi/themes/onedark.rasi"
